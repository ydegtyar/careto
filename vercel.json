{
  "rewrites": [
    { "source": "/api/sync/:action", "destination": "/api/sync/[action]" },
    { "source": "/api/fx/:action", "destination": "/api/fx/[action]" },
    { "source": "/api/vehicles/:action", "destination": "/api/vehicles/[action]" },
    { "source": "/api/invites/:action", "destination": "/api/invites/[action]" },
    { "source": "/api/attachments/:action", "destination": "/api/attachments/[action]" },
    { "source": "/api/push/:action", "destination": "/api/push/[action]" },
    { "source": "/api/export/:action", "destination": "/api/export/[action]" },
    { "source": "/api/ai/:action", "destination": "/api/ai/[action]" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known/[type]?type=protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known/[type]?type=authorization-server" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/well-known/[type]?type=openid-configuration" },
    { "source": "/api/mcp/oauth", "destination": "/api/mcp/oauth" },
    { "source": "/api/mcp/:action", "destination": "/api/mcp/[action]" },
    { "source": "/api/keys/:action", "destination": "/api/keys/[action]" },
    { "source": "/api/auth/(.*)", "destination": "/api/auth/[...all]?__path=$1" },
    { "source": "/((?!api/|\\.well-known/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
