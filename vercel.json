{
  "rewrites": [
    { "source": "/api/sync/:action", "destination": "/api/sync/[action]" },
    { "source": "/api/fx/:action", "destination": "/api/fx/[action]" },
    { "source": "/api/vehicles/:action", "destination": "/api/vehicles/[action]" },
    { "source": "/api/invites/:action", "destination": "/api/invites/[action]" },
    { "source": "/api/attachments/:action", "destination": "/api/attachments/[action]" },
    { "source": "/api/push/:action", "destination": "/api/push/[action]" },
    { "source": "/api/export/:action", "destination": "/api/export/[action]" },
    { "source": "/api/auth/:path*", "destination": "/api/auth/[...all]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
